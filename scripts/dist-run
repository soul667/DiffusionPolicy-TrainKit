#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  cat >&2 <<'USAGE'
Usage:
  dist-run TRAINING_SCRIPT [args...]

Single node:
  NPROC_PER_NODE=4 dist-run train.py ...

Multi node (run on every node):
  NNODES=2 NODE_RANK=0 MASTER_ADDR=10.0.0.10 MASTER_PORT=29500 NPROC_PER_NODE=4 dist-run train.py ...
  NNODES=2 NODE_RANK=1 MASTER_ADDR=10.0.0.10 MASTER_PORT=29500 NPROC_PER_NODE=4 dist-run train.py ...
USAGE
  exit 2
fi

NNODES="${NNODES:-1}"
NODE_RANK="${NODE_RANK:-0}"
MASTER_ADDR="${MASTER_ADDR:-127.0.0.1}"
MASTER_PORT="${MASTER_PORT:-29500}"

if [[ -z "${NPROC_PER_NODE:-}" ]]; then
  if command -v nvidia-smi >/dev/null 2>&1; then
    NPROC_PER_NODE="$(nvidia-smi --query-gpu=index --format=csv,noheader | wc -l | tr -d ' ')"
  else
    NPROC_PER_NODE=1
  fi
fi

TRAIN_SCRIPT="$1"
shift
if [[ "$TRAIN_SCRIPT" != */* ]]; then
  RESOLVED="$(command -v "$TRAIN_SCRIPT" || true)"
  [[ -n "$RESOLVED" ]] && TRAIN_SCRIPT="$RESOLVED"
fi

if [[ "$NNODES" == "1" ]]; then
  exec torchrun \
    --standalone \
    --nproc-per-node="$NPROC_PER_NODE" \
    "$TRAIN_SCRIPT" "$@"
else
  exec torchrun \
    --nnodes="$NNODES" \
    --node-rank="$NODE_RANK" \
    --nproc-per-node="$NPROC_PER_NODE" \
    --master-addr="$MASTER_ADDR" \
    --master-port="$MASTER_PORT" \
    "$TRAIN_SCRIPT" "$@"
fi
